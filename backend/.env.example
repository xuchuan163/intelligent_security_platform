# Database connection pool (Phase 4-C.6)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=3600

# Cache TTLs (seconds)
CACHE_PROFILE_TTL_SECONDS=600
CACHE_NL2SQL_TTL_SECONDS=600
CACHE_EMPTY_TTL_SECONDS=60

# Neo4j (enable when local instance is running)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
